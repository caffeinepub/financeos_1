[
  {
    "match": ".well-known",
    "ignore": false,
    "headers": {
      "Content-Type": "text/plain"
    }
  },
  {
    "match": ".well-known/ic-domains",
    "ignore": false,
    "headers": {
      "Content-Type": "text/plain",
      "Cache-Control": "public, max-age=3600",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": ".well-known/ii-alternative-origins",
    "ignore": false,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "**",
    "cache": {
      "max_age": 31536000
    }
  }
]
